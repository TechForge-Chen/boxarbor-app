<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<JavaSdkDirectory>C:\Program Files\Microsoft\jdk-21.0.11.10-hotspot</JavaSdkDirectory>
		<AndroidSdkDirectory>D:\Program Files (x86)\Microsoft Visual Studio\shared\Android\android-sdk</AndroidSdkDirectory>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<RootNamespace>Net</RootNamespace>
		<UseMaui>true</UseMaui>
 		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>BoxArbor</ApplicationTitle>
		<ApplicationId>com.boxarbor.app</ApplicationId>
		<ApplicationDisplayVersion>2.4.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-android'">
	  <AotAssemblies>false</AotAssemblies>
	  <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
	  <AndroidKeyStore>true</AndroidKeyStore>
	  <AndroidSigningKeyStore>upload-keystore.keystore</AndroidSigningKeyStore>
	  <AndroidSigningKeyAlias>upload</AndroidSigningKeyAlias>
	  <AndroidSigningKeyPass>REMOVED</AndroidSigningKeyPass>
	  <AndroidSigningStorePass>REMOVED</AndroidSigningStorePass>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
	  <!-- 签名由发布流程提供：本地/CI 通过 -p:CodesignKey 与 -p:CodesignProvision 指定
	       （App Store 需 Apple Distribution 证书 + App Store 描述文件）。此处不再写死开发证书。 -->
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-ios|AnyCPU'">
	  <BuildIpa>True</BuildIpa>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-ios|AnyCPU'">
	  <BuildIpa>True</BuildIpa>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#16c95c" />
		<MauiSplashScreen Include="Resources\Splash\splash_icon.png" Color="#16c95c" BaseSize="96,104" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="MainPage.xaml.cs" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Remove="MainPage.xaml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.2" />
		<PackageReference Include="Plugin.BLE" Version="3.2.0" />
		<PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.2" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Board.xaml.cs">
	    <DependentUpon>Board.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="StartPage.xaml.cs">
	    <DependentUpon>StartPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="DataPage.xaml.cs">
	    <DependentUpon>DataPage.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="SetPage.xaml.cs">
	    <DependentUpon>SetPage.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Board.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="StartPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="DataPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="SetPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="WifiPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>
