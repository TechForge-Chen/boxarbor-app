<?xml version="1.0" encoding="utf-8" ?>
<!-- 开屏页 · Figma 246:362 "开屏页面"（375x812）
     底色 #16c95c + 白色 logo-faithful（246:356 导出 128x138 @123,267），无 slogan。
     系统启动屏（MauiSplashScreen）同款底色 + 同一 logo。 -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BluetoothMauiApp.SplashPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#16c95c">

    <Grid>

        <!-- Logo / logo-faithful · 246:356 (123,267) 128x138 -->
        <Image Source="splash_glyph.png"
               WidthRequest="128" HeightRequest="138"
               Aspect="AspectFit"
               HorizontalOptions="Center" VerticalOptions="Start"
               Margin="0,267,0,0"
               InputTransparent="true" />

    </Grid>
</ContentPage>
