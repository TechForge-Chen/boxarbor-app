<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Brand colors (consistent across themes) -->
    <Color x:Key="BrandGreen">#28b958</Color>
    <Color x:Key="BrandGreenDark">#3dd97a</Color>
    <Color x:Key="StatusRed">#ff4777</Color>
    <Color x:Key="OnlineGreen">#0eb83a</Color>

    <!-- Semantic light/dark pairs for code-behind lookup -->
    <Color x:Key="PageBgLight">#f0f0f4</Color>
    <Color x:Key="PageBgDark">#141414</Color>
    <Color x:Key="CardBgLight">#ffffff</Color>
    <Color x:Key="CardBgDark">#1f1f1f</Color>
    <Color x:Key="SubCardBgLight">#f7f8f9</Color>
    <Color x:Key="SubCardBgDark">#2a2a2a</Color>
    <Color x:Key="GreenTintLight">#e6f5e9</Color>
    <Color x:Key="GreenTintDark">#1a3a23</Color>
    <Color x:Key="GreenFaintLight">#fcfefc</Color>
    <Color x:Key="GreenFaintDark">#1a2a20</Color>
    <Color x:Key="BlueTintLight">#E8F4FD</Color>
    <Color x:Key="BlueTintDark">#1a2a3a</Color>
    <Color x:Key="GrayNumBgLight">#f2f2f2</Color>
    <Color x:Key="GrayNumBgDark">#2a2a2a</Color>
    <Color x:Key="ConfigBgLight">#F5F5F5</Color>
    <Color x:Key="ConfigBgDark">#1f1f1f</Color>
    <Color x:Key="PrimaryTextLight">#111111</Color>
    <Color x:Key="PrimaryTextDark">#ffffff</Color>
    <Color x:Key="SecondaryTextLight">#757575</Color>
    <Color x:Key="SecondaryTextDark">#aaaaaa</Color>
    <Color x:Key="TertiaryTextLight">#666666</Color>
    <Color x:Key="TertiaryTextDark">#888888</Color>
    <Color x:Key="SubtleTextLight">#777777</Color>
    <Color x:Key="SubtleTextDark">#999999</Color>
    <Color x:Key="BorderLight">#dddddd</Color>
    <Color x:Key="BorderDark">#3a3a3a</Color>
    <Color x:Key="LightBorderLight">#eeeeee</Color>
    <Color x:Key="LightBorderDark">#333333</Color>
    <Color x:Key="DividerLight">#e0e0e0</Color>
    <Color x:Key="DividerDark">#333333</Color>

    <!-- ============================================================
         智能控制APP (Figma MhfMUp4iE1xpXK6pDrXBZn) 设计令牌
         明/暗值来源：Value.tokens.json（成对 token）+ 暗稿画板按图层提取；
         切换入口 ThemeManager.Apply。暗色值以 2026-09-30 改暗后的
         0922主流程画板为准。
         ============================================================ -->
    <Color x:Key="DgPageBg">#f6f7f7</Color>
    <Color x:Key="DgCard">#ffffff</Color>
    <Color x:Key="DgCardSelected">#fafbfd</Color>
    <Color x:Key="DgIconBg">#f0f2ef</Color>
    <Color x:Key="DgIconBgAlt">#f2f5f2</Color>

    <Color x:Key="DgGreen">#16c95c</Color>
    <Color x:Key="DgGreenBtn">#12bd63</Color>
    <Color x:Key="DgGreenScan">#0ac457</Color>
    <Color x:Key="DgGreenLink">#0a8f49</Color>
    <Color x:Key="DgGreenText">#20914d</Color>
    <Color x:Key="DgGreenText2">#21834b</Color>
    <Color x:Key="DgGreenText3">#25844d</Color>
    <Color x:Key="DgGreenRing">#1c8c47</Color>
    <Color x:Key="DgGreenFaint">#e0faeb</Color>

    <Color x:Key="DgTitle">#080808</Color>
    <Color x:Key="DgTitleAlt">#172d22</Color>
    <Color x:Key="DgSceneTitle">#202925</Color>
    <Color x:Key="DgSub">#615e5c</Color>
    <Color x:Key="DgSub2">#7a7570</Color>
    <Color x:Key="DgSub3">#7a857d</Color>
    <Color x:Key="DgSub4">#66786e</Color>
    <Color x:Key="DgMuted">#8b938e</Color>
    <Color x:Key="DgLabel">#62796b</Color>
    <Color x:Key="DgLabel2">#7b8981</Color>
    <Color x:Key="DgNum">#4c6858</Color>

    <Color x:Key="DgOffline">#f2402e</Color>
    <Color x:Key="DgOfflineBg">#ffe8e3</Color>
    <Color x:Key="DgTrack">#dce6df</Color>
    <Color x:Key="DgTrackRing">#bcc5be</Color>
    <Color x:Key="DgDivider">#e0ded9</Color>
    <Color x:Key="DgDivider2">#c5dace</Color>
    <Color x:Key="DgSwitchOff">#bababa</Color>

    <!-- 弹窗 -->
    <Color x:Key="DgDialogBg">#f4faf6</Color>
    <Color x:Key="DgDialogBg2">#f7fffa</Color>
    <Color x:Key="DgDialogBorder">#dbe8e0</Color>
    <Color x:Key="DgDialogText">#172e21</Color>
    <Color x:Key="DgPickerBg">#f1fcf6</Color>
    <Color x:Key="DgPickerTitle">#183a29</Color>
    <Color x:Key="DgPickerSub">#61796a</Color>
    <Color x:Key="DgPickerCancelBg">#e1eee7</Color>
    <Color x:Key="DgPickerCancelText">#426451</Color>
    <Color x:Key="DgBackdrop">#0d241b</Color>

    <!-- 页面氛围底：#f6f7f7 上叠三团柔和色晕 -->
    <Color x:Key="DgAtmosBase">#f6f7f7</Color>
    <Color x:Key="DgTabBarFill">White</Color>
    <Color x:Key="DgAtmosGreen">#b1ffd4</Color>
    <Color x:Key="DgAtmosBlue">#cce0f5</Color>
    <Color x:Key="DgAtmosGreen2">#cfe8db</Color>

    <!-- 暗色专用/场景专用（ThemeManager 切换） -->
    <Color x:Key="DgSceneCard">#ffffff</Color>
    <Color x:Key="DgSceneCardStroke">#ffffff</Color>
    <Color x:Key="DgIllustrationCard">#ffffff</Color>
    <Color x:Key="DgGuideChip">#ffffff</Color>

    <!-- 描边：卡片白描边亮态保留，暗态换低透明浅绿（设计稿 #A2D4B8@16%） -->
    <Color x:Key="DgEdge">#FFFFFF</Color>
    <!-- 绿色按钮描边：亮态白、暗态与按钮同绿（暗稿无白描边） -->
    <Color x:Key="DgGreenBtnEdge">#FFFFFF</Color>
    <!-- 表单字段（重命名输入框/取消钮、Board Count 等） -->
    <Color x:Key="DgField">#FFFFFF</Color>
    <!-- 保存至 Scene 弹窗未选项底色 -->
    <Color x:Key="DgSaveOpt">#FFFFFF</Color>
    <Color x:Key="DgSaveDotRing">#8cb09c</Color>
    <!-- 亮绿强调（滑块圆点/选中单选/开关滑块）：暗稿 #43DC89 -->
    <Color x:Key="DgGreenBright">#12bd63</Color>
    <Color x:Key="DgGreenAccent">#16c95c</Color>
    <!-- 网关状态卡（暗态 60% 半透明 #21372B） -->
    <Color x:Key="DgStatusCard">#ffffff</Color>
    <!-- 网关网格卡（暗态 72% 半透明 #21372B） -->
    <Color x:Key="DgGridCard">#ffffff</Color>
    <!-- 灯控页左侧 Box 轨 -->
    <Color x:Key="DgRailColumn">#ffffff</Color>
    <Color x:Key="DgRailChip">#ffffff</Color>
    <Color x:Key="DgRailChipEdge">#ffffff</Color>

</ResourceDictionary>